{
  "hosting": {
    "public": "dist/Unite-Frontend/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/e/new",
        "destination": "/index.html"
      },
      {
        "source": "/e/**",
        "run": {
          "serviceId": "unite-backend",
          "region": "europe-west1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
