{
  "hosting": {
    "public": "dist/Unite-Frontend/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "regex": "^/e/(.+)$",
        "destination": "/event/:1",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/event/new",
        "destination": "/index.html"
      },
      {
        "source": "/event/**",
        "run": {
          "serviceId": "unite-backend",
          "region": "europe-west1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
